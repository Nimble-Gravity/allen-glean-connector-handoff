# =============================================================================
# Allen & Co Glean Connector — environment configuration
# Copy to .env and fill in. The .env is shared by the indexer (src/) and the
# Custom Action API (allenco_custom_action/, which loads ../.env).
# =============================================================================

# --- Glean Indexing API ------------------------------------------------------
GLEAN_INSTANCE=your-instance
GLEAN_INDEXING_API_KEY=your-indexing-api-key
GLEAN_DATASOURCE=allenco_ems
GLEAN_ENABLE_INDEXING=false
GLEAN_FULL_REFRESH=false

# Optional: JSON array of emails who can see all indexed documents.
# Format: ["user@allenandco.com", "other@allenandco.com"]
# datasource_user_id is derived automatically as sha256(lowercased email).
GLEAN_INDEXING_SUPERUSER_ALLOWED_USERS=

# --- Incremental sync state (persist metadata to avoid re-processing) ---------
# Backend: none (default, full fetch each run) | file (local JSON) | blob (Azure).
SYNC_STATE_BACKEND=none
# file backend:
SYNC_STATE_FILE=.sync-state/state.json
# blob backend (prod; auth via the workload's managed identity):
SYNC_STATE_BLOB_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
SYNC_STATE_BLOB_CONTAINER=sync-state
SYNC_STATE_BLOB_NAME=allenco-connector-state.json

# --- Logging -----------------------------------------------------------------
LOG_DEBUG=false
DEBUG_FILES=false
# Base dir for dry-run JSON dumps (.outputs/) and file logs (logs/). Defaults to
# the current working directory. In the container this is /app (writable); set it
# only to override.
CONNECTOR_OUTPUT_DIR=

# --- Custom Action API -------------------------------------------------------
CUSTOM_ACTION_API_KEY=your-custom-action-api-key
# Max rows returned by GET /query per request (default 500, minimum 1).
MAX_ROWS=500

# --- Notifications (email and/or Slack; both optional) -----------------------
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_CONNECTOR_NAME=Allen & Co Glean Connector

# Slack incoming webhook (Allen & Co's preferred channel). Leave empty to disable.
SLACK_WEBHOOK_URL=

# SMTP email (optional alternative/additional channel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFY_EMAIL_FROM=
# Comma-separated recipient list, e.g. it-team@allenandco.com, oncall@allenandco.com
NOTIFY_EMAIL_TO=

# --- Local Docker dev (docker-compose.dev.yml) -------------------------------
# For the local loop against the Docker SQL, use these instead of the Azure block
# below (run the connector from a venv against localhost:1433):
#   DB_SERVER=localhost
#   DB_NAME=ems
#   DB_AUTH_MODE=sql
#   DB_USER=glean_dev
#   DB_PASSWORD=Gl3an_Dev_Passw0rd!
#   DB_TRUST_SERVER_CERTIFICATE=true     # ⚠️ dev only — container cert is self-signed
#   GLEAN_INDEXING_SUPERUSER_ALLOWED_USERS=["dev@allenandco.com"]

# --- Azure SQL Managed Instance ----------------------------------------------
# FQDN of the MI (private IP inside the VNet), or 127.0.0.1 when using a tunnel.
DB_SERVER=your-mi.<zone>.database.windows.net
DB_NAME=your-database-name
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server

# Authentication mode:
#   sql     → SQL login (needs DB_USER + DB_PASSWORD). Dev phase.
#   msi     → Managed identity (Authentication=ActiveDirectoryMsi). Azure prod.
#   default → Authentication=ActiveDirectoryDefault (az-login / env / MSI chain).
DB_AUTH_MODE=sql
DB_USER=your-sql-user
DB_PASSWORD=your-sql-password

# For DB_AUTH_MODE=msi with a USER-assigned managed identity, set its client ID so
# the ODBC driver (and the Blob sync-state credential) target the right identity.
# In Azure Container Apps this is injected automatically as AZURE_CLIENT_ID; set it
# explicitly only when running outside that injection. DB_MSI_CLIENT_ID overrides
# AZURE_CLIENT_ID for the DB connection if both are set.
DB_MSI_CLIENT_ID=
# AZURE_CLIENT_ID=

# TLS — Azure SQL MI has a real, validatable certificate: keep this false.
# (SMART used true for on-prem self-signed certs — do NOT copy that here.)
DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=true
# Only when connecting through a local SSH tunnel (Option B2): the MI's real FQDN,
# so the driver validates the cert even though DB_SERVER is 127.0.0.1.
DB_HOST_NAME_IN_CERTIFICATE=
